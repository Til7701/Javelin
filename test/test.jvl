Bool and = true && false;

Io.println(Bool.asStr(and));

Bool a = new true;
a = new false;

Bool b = new true;
a = b;
b = new false;

false = new true;
Io.println("Should say true: " + Bool.asStr(false));
false = "a" == "b";
Io.println("Should say false: " + Bool.asStr(false));

Io.println("Hello World");

Str[Bool] array = [ "Hello", "World" ];
