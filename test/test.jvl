Io.println(value);
value = "Override";
Io.println(array[true]);

Bool x = new false;
when x == new true {
    Io.println("triggered");
    x = new true;
}

Io.println("Setting to true");
x = new true;
Io.println("Setting to false");
x = new false;
Io.println("Setting to true");
x = new true;
